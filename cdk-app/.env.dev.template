# Template for your DEV deployment's inputs. Copy to cdk-app/.env.dev: the file
# every development command and Compose read (Studio's CDK environment files
# island can generate it). There is no cdk-app/.env.

# ==============================================================================
#  ENVIRONMENT & DEPLOYMENT SETTINGS
# ==============================================================================
# The mode is not set here: commands build development unless they say
# -c prodDeployment=true, and production deployments are targets declared in
# cdk-app/cdk.json under "framework:targets".

# Your own development deployment's name (lowercase letters, numbers, hyphens).
# Give each developer a distinct one; it may not be a declared target's name.
# Stack name format: <CDK_APP_NAME>-<StackName>
CDK_APP_NAME=my-aws-app


# ==============================================================================
#  AUTHENTICATION & OAUTH
# ==============================================================================
# Google OAuth provider for Cognito identity federation.
# Optional: Uncomment and populate when enabling Google Sign-In in Cognito.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Custom Cognito hosted-UI domain configuration.
# When set to true, you must uncomment and populate COGNITO_DOMAIN_NAME and COGNITO_DOMAIN_CERTIFICATE_ARN below.
USE_COGNITO_CUSTOM_DOMAIN=false
# COGNITO_DOMAIN_NAME=https://auth.example.com
# COGNITO_DOMAIN_CERTIFICATE_ARN=<YOUR_COGNITO_DOMAIN_CERTIFICATE_ARN>

# Development-only user auto-confirmation (production deployment ignores this)
SKIP_EMAIL_VERIFICATION=true


# ==============================================================================
#  LOCAL DEVELOPMENT & AWS ENVIRONMENT
# ==============================================================================
# Origin URL trusted for Cognito callbacks, CORS, and local dev servers
LOCAL_DEV_URL=http://localhost:3000

# Optional profile for direct Docker Compose; blank uses the AWS default profile.
# npm run dev:containers selects its own profile with --profile=<profile> (default: default).
LOCAL_AWS_PROFILE=
LOCAL_AWS_REGION=us-east-1

# Test account (never set in prod). `npm run dev:containers` creates it in the dev
# pool and local database, verified, with this password (12+ characters); sign in
# as it in the browser or with `npm run dev:request`. Use an address you control:
# a password reset mails a code there.
LOCAL_TEST_USER_EMAIL=testuser@gmail.com
LOCAL_TEST_USER_PASSWORD=Password12345


# ==============================================================================
#  LOCAL CONTAINER PORT BINDINGS
# ==============================================================================
# Host ports published by Docker Compose (change if port collision occurs)
LOCAL_API_DEV_SERVER_HOST_PORT=8080
LOCAL_WS_DEV_SERVER_HOST_PORT=8081
LOCAL_INVOCATION_RUNNER_HOST_PORT=8090
WS_TESTER_HOST_PORT=3001
POSTGRES_HOST_PORT=5432
PGADMIN_HOST_PORT=5050


# ==============================================================================
#  LOCAL LAMBDA RUNTIME PERFORMANCE
# ==============================================================================
# Keeps warm Node processes in local dev servers to reduce cold start latency
LOCAL_LAMBDA_WARM=true
LOCAL_LAMBDA_WARM_MAX=6
LOCAL_LAMBDA_WARM_IDLE_SECONDS=120


# ==============================================================================
#  DATABASE (RDS)
# ==============================================================================
# A dev deployment builds no RDS: Compose Postgres stands in for it, so only a
# production deployment uses these. Shown with their production defaults; see
# cdk-app/.env.prod.template for what each one costs and constrains.
# DATABASE_INSTANCE_CLASS=db.t3.micro
# DATABASE_ENGINE_VERSION=16
# DATABASE_ALLOW_MAJOR_VERSION_UPGRADE=false
# DATABASE_MULTI_AZ=false
# DATABASE_STORAGE_TYPE=gp2
# DATABASE_ALLOCATED_STORAGE_GIB=20
# DATABASE_MAX_ALLOCATED_STORAGE_GIB=100
# DATABASE_STORAGE_IOPS=
# DATABASE_STORAGE_THROUGHPUT_MIBPS=
# DATABASE_BACKUP_RETENTION_DAYS=7
# DATABASE_BACKUP_WINDOW=02:00-02:30
# DATABASE_MAINTENANCE_WINDOW=sun:03:00-sun:03:30
# DATABASE_AUTO_MINOR_VERSION_UPGRADE=true
# DATABASE_APPLY_IMMEDIATELY=false
# DATABASE_READ_REPLICA_COUNT=0
# DATABASE_READ_REPLICA_INSTANCE_CLASS=
# DATABASE_READ_REPLICA_MULTI_AZ=false
# DATABASE_PROXY_ENABLED=false
# DATABASE_PROXY_MAX_CONNECTIONS_PERCENT=90
# DATABASE_PROXY_BORROW_TIMEOUT_SECONDS=15
# DATABASE_PROXY_IDLE_CLIENT_TIMEOUT_SECONDS=1800
# DATABASE_CLOUDWATCH_LOGS_EXPORTS=postgresql,upgrade
# DATABASE_LOG_RETENTION_DAYS=30


# ==============================================================================
#  FEATURE FLAGS & SERVICES
# ==============================================================================
# Deploys AWS WebSocket API Gateway and handler Lambdas routed via framework-config.
# Also in a dev deployment, beside local-ws-dev-server: the handlers then may not
# declare database: true, a subnet, or a task, workflow or agent binding.
DEPLOY_PROD_WEBSOCKET_API=false


# ==============================================================================
#  LANGGRAPH MODEL SELECTION
# ==============================================================================
# Allowed values (case-insensitive): bedrock-mantle, bedrock, openai
# Leave blank to use the default in framework-config/resources.ts (bedrock-mantle)
LANGGRAPH_MODEL_PROVIDER=

# ==============================================================================
#  PROVIDER MODEL CONFIGURATION
# ==============================================================================
# Optional: Leave blank to use the model defaults in framework-config/resources.ts
LANGGRAPH_BEDROCK_MANTLE_MODEL_ID=
LANGGRAPH_BEDROCK_MODEL_ID=
LANGGRAPH_OPENAI_MODEL_ID=

# ==============================================================================
#  API AUTHENTICATION
# ==============================================================================
# Required when LANGGRAPH_MODEL_PROVIDER="openai"
OPENAI_API_KEY=
