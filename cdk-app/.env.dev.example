# Template for a DEV deployment. Copy to cdk-app/.env -- the CDK app loads only
# that file. Annotations sit on their own line: an unquoted "#" ends the value.

# Deployment mode. false creates the local dev stack (Cognito, async lambdas and
# the replay stack in AWS; frontend and API served locally).
# Override per command with -c useLocalDevStack=true|false.
PROD_DEPLOYMENT=false

# OAuth client id. Its matching secret is a declared resource, so it lives
# in the generated block below.
GOOGLE_CLIENT_ID=

# Additional OAuth providers TBD.
# ..
# ..

# The origin client-app is served on. Trusted by this dev deployment for Cognito
# callbacks and CORS, and by the local dev servers for the same. A LAN address
# such as http://192.168.1.20:3000 works for CORS and native auth, but Cognito
# refuses a non-loopback HTTP hosted-UI redirect.
LOCAL_DEV_URL=http://localhost:3000

# AWS profile and region the containers use, via the mounted ~/.aws.
LOCAL_AWS_PROFILE=dev
LOCAL_AWS_REGION=us-east-1

# A dedicated user in this dev user pool, for headless checks with
# npm run dev:request. Create it through the app's sign-up page and keep
# two-step verification off. Never set these for a production deployment.
LOCAL_TEST_USER_EMAIL=
LOCAL_TEST_USER_PASSWORD=

# Host ports Docker Compose publishes. Required: a port is a fact about this
# machine, and a silent default is what makes a collision hard to find. Change
# any that is already taken here and re-run npm run export:cdk-outputs. A
# container's own port never collides and is not configurable.
LOCAL_API_DEV_SERVER_HOST_PORT=8080
LOCAL_WS_DEV_SERVER_HOST_PORT=8081
LOCAL_INVOCATION_RUNNER_HOST_PORT=8090
FRONTEND_WS_CONNECTION_AND_PAYLOAD_TESTER_HOST_PORT=3001
POSTGRES_HOST_PORT=5432
PGADMIN_HOST_PORT=5050

# Lowercase deployment name: letters, numbers, and hyphens only.
# Every stack is named <CDK_APP_NAME>-<StackName>, and the Cognito hosted-UI
# domain prefix is derived from this plus the account and region.
CDK_APP_NAME=matts-aws-framework

# Custom Cognito hosted-UI domain configuration.
USE_COGNITO_CUSTOM_DOMAIN=false
# COGNITO_DOMAIN_NAME=https://auth.example.com
# COGNITO_DOMAIN_CERTIFICATE_ARN=<YOUR_COGNITO_DOMAIN_CERTIFICATE_ARN>

# WebSocket configuration.
# DEPLOY_WEBSOCKET_API creates the AWS WebSocket API Gateway and the handler
# Lambdas it routes to; off, neither is built. The authorizer declared on
# $connect in framework-config/websocket/routes.ts is always attached.
DEPLOY_WEBSOCKET_API=false

# Confirm new users without an emailed code. Development only: a production
# deployment refuses it, and federated sign-in never links to an account whose
# email was confirmed this way.
SKIP_EMAIL_VERIFICATION=true

# Warm handler processes in the local dev servers. Each Node Lambda you call
# keeps one process for its next call, as a warm Lambda does; at most
# LOCAL_LAMBDA_WARM_MAX exist, and each stops after LOCAL_LAMBDA_WARM_IDLE_SECONDS
# without work. false starts every invocation cold.
LOCAL_LAMBDA_WARM=true
LOCAL_LAMBDA_WARM_MAX=6
LOCAL_LAMBDA_WARM_IDLE_SECONDS=120

# BEGIN GENERATED FRAMEWORK INPUTS
# Generated by npm run framework:generate from framework.config.ts. Do not edit this block.
# Copy this example to cdk-app/.env for authored cloud and local inputs.
# Cloud reads use the corresponding -c camelCaseName as an override.

# Allowed values (case-insensitive): bedrock-mantle, bedrock, openai.
# resources.langgraph.modelProvider
LANGGRAPH_MODEL_PROVIDER=bedrock-mantle

# Optional; leave blank to use the workload's runtime fallback, if any.
# resources.langgraph.bedrockModelId
LANGGRAPH_BEDROCK_MODEL_ID=
# resources.langgraph.bedrockMantleModelId
LANGGRAPH_BEDROCK_MANTLE_MODEL_ID=
# resources.langgraph.openaiModelId
LANGGRAPH_OPENAI_MODEL_ID=

# Secrets: the raw value, authored here and nowhere else.
# Compose passes it straight to the container locally. For a deployment,
# npm run deploy copies it into Secrets Manager as ${CDK_APP_NAME}/secret/<NAME>,
# and only that secret's ARN ever reaches a CloudFormation template.
# Read by service:langgraph.
# Required for deployed service:langgraph when LANGGRAPH_MODEL_PROVIDER="openai".
OPENAI_API_KEY=
# resources.googleClientSecret, read where the stacks are composed.
GOOGLE_CLIENT_SECRET=
# END GENERATED FRAMEWORK INPUTS
