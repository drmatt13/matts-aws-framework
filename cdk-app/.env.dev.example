# Template for a DEV deployment. Copy to cdk-app/.env -- the CDK app loads only
# that file.

# ==============================================================================
#  ENVIRONMENT & DEPLOYMENT SETTINGS
# ==============================================================================
# Deployment mode: false creates local dev stack (Cognito, async lambdas, replay stack).
# Override per command with -c useLocalDevStack=true|false.
PROD_DEPLOYMENT=false

# Lowercase deployment name (letters, numbers, hyphens only).
# Stack name format: <CDK_APP_NAME>-<StackName>
CDK_APP_NAME=my-aws-app


# ==============================================================================
#  AUTHENTICATION & OAUTH
# ==============================================================================
# Google OAuth provider for Cognito identity federation.
# Optional: Uncomment and populate when enabling Google Sign-In in Cognito.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Custom Cognito hosted-UI domain configuration.
# When set to true, you must uncomment and populate COGNITO_DOMAIN_NAME and COGNITO_DOMAIN_CERTIFICATE_ARN below.
USE_COGNITO_CUSTOM_DOMAIN=false
# COGNITO_DOMAIN_NAME=https://auth.example.com
# COGNITO_DOMAIN_CERTIFICATE_ARN=<YOUR_COGNITO_DOMAIN_CERTIFICATE_ARN>

# Development-only user auto-confirmation (production deployment ignores this)
SKIP_EMAIL_VERIFICATION=true


# ==============================================================================
#  LOCAL DEVELOPMENT & AWS ENVIRONMENT
# ==============================================================================
# Origin URL trusted for Cognito callbacks, CORS, and local dev servers
LOCAL_DEV_URL=http://localhost:3000

# AWS profile and region mounted via ~/.aws
LOCAL_AWS_PROFILE=dev
LOCAL_AWS_REGION=us-east-1

# Dedicated headless test account for `npm run dev:request` (never set in prod)
LOCAL_TEST_USER_EMAIL=testuser@gmail.com
LOCAL_TEST_USER_PASSWORD=Password12345


# ==============================================================================
#  LOCAL CONTAINER PORT BINDINGS
# ==============================================================================
# Host ports published by Docker Compose (change if port collision occurs)
LOCAL_API_DEV_SERVER_HOST_PORT=8080
LOCAL_WS_DEV_SERVER_HOST_PORT=8081
LOCAL_INVOCATION_RUNNER_HOST_PORT=8090
FRONTEND_WS_CONNECTION_AND_PAYLOAD_TESTER_HOST_PORT=3001
POSTGRES_HOST_PORT=5432
PGADMIN_HOST_PORT=5050


# ==============================================================================
#  LOCAL LAMBDA RUNTIME PERFORMANCE
# ==============================================================================
# Keeps warm Node processes in local dev servers to reduce cold start latency
LOCAL_LAMBDA_WARM=true
LOCAL_LAMBDA_WARM_MAX=6
LOCAL_LAMBDA_WARM_IDLE_SECONDS=120


# ==============================================================================
#  FEATURE FLAGS & SERVICES
# ==============================================================================
# Deploys AWS WebSocket API Gateway and handler Lambdas routed via framework-config
DEPLOY_WEBSOCKET_API=false


# ==============================================================================
#  LANGGRAPH MODEL SELECTION
# ==============================================================================
# Allowed values (case-insensitive): bedrock-mantle, bedrock, openai
LANGGRAPH_MODEL_PROVIDER=bedrock-mantle

# ==============================================================================
#  PROVIDER MODEL CONFIGURATION
# ==============================================================================
# Optional: Leave blank to use the workload's runtime fallback
LANGGRAPH_BEDROCK_MANTLE_MODEL_ID=
LANGGRAPH_BEDROCK_MODEL_ID=
LANGGRAPH_OPENAI_MODEL_ID=

# ==============================================================================
#  API AUTHENTICATION
# ==============================================================================
# Required when LANGGRAPH_MODEL_PROVIDER="openai"
OPENAI_API_KEY=

