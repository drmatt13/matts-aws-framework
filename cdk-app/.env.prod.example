# Template for a PROD deployment. Copy to cdk-app/.env -- the CDK app loads only
# that file.

# ==============================================================================
#  ENVIRONMENT & DEPLOYMENT SETTINGS
# ==============================================================================
# Deployment mode: true creates the full cloud stack (CloudFront + S3 frontend, RDS, HTTP API).
# Override per command with -c useLocalDevStack=true|false.
PROD_DEPLOYMENT=true

# Lowercase deployment name (letters, numbers, hyphens only).
# Stack name format: <CDK_APP_NAME>-<StackName>
CDK_APP_NAME=my-aws-app


# ==============================================================================
#  FRONTEND CUSTOM DOMAIN
# ==============================================================================
# Alternate domain name attached to CloudFront. When false, the generated CloudFront URL is used.
# Both options support same-origin /api and browser authentication after deployment and client publication.
# When set to true, you must uncomment and populate FRONTEND_URL and FRONTEND_CLOUDFRONT_CERTIFICATE_ARN below.
# The certificate must be ACM in us-east-1, in the same AWS account as the deployment.
USE_FRONTEND_CUSTOM_DOMAIN=false
# FRONTEND_URL=https://app.example.com
# FRONTEND_CLOUDFRONT_CERTIFICATE_ARN=<YOUR_FRONTEND_CLOUDFRONT_CERTIFICATE_ARN>


# ==============================================================================
#  AUTHENTICATION & OAUTH
# ==============================================================================
# Google OAuth provider for Cognito identity federation.
# Optional: Uncomment and populate when enabling Google Sign-In in Cognito.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Custom Cognito hosted-UI domain configuration.
# When set to true, you must uncomment and populate COGNITO_DOMAIN_NAME and COGNITO_DOMAIN_CERTIFICATE_ARN below.
USE_COGNITO_CUSTOM_DOMAIN=false
# COGNITO_DOMAIN_NAME=https://auth.example.com
# COGNITO_DOMAIN_CERTIFICATE_ARN=<YOUR_COGNITO_DOMAIN_CERTIFICATE_ARN>

# SKIP_EMAIL_VERIFICATION is development-only: a production deployment refuses it. Leave it unset.


# ==============================================================================
#  COGNITO EMAIL DELIVERY (SES)
# ==============================================================================
# Cognito's built-in sender is capped at about 50 emails a day; production sends through SES.
# Use an address (or domain) already verified in SES. COGNITO_SES_REGION defaults to the stack's region.
# COGNITO_SES_FROM_EMAIL=<YOUR_VERIFIED_EMAIL>
# COGNITO_SES_FROM_NAME=Example App
# COGNITO_SES_REGION=us-east-1


# ==============================================================================
#  DATABASE (RDS)
# ==============================================================================
# These options apply only to production RDS; development uses Compose Postgres.
# Defaults preserve the small existing deployment. Choose a suitable instance and
# enable Multi-AZ + RETAIN_STATEFUL_RESOURCES for durable production applications.
# Review the CDK diff and maintenance impact before applying infrastructure changes.
DATABASE_INSTANCE_CLASS=db.t3.micro
DATABASE_ENGINE_VERSION=16
# Major upgrades need an explicit compatibility/release plan; this flag only permits AWS's upgrade.
DATABASE_ALLOW_MAJOR_VERSION_UPGRADE=false
DATABASE_MULTI_AZ=false

# gp2 preserves existing storage. Prefer gp3 for new deployments; io2 needs explicit IOPS.
DATABASE_STORAGE_TYPE=gp2
DATABASE_ALLOCATED_STORAGE_GIB=20
# 0 disables autoscaling; otherwise at least 10% above allocated storage. Storage cannot shrink.
DATABASE_MAX_ALLOCATED_STORAGE_GIB=100
# Optional: PostgreSQL gp3 custom IOPS/throughput requires at least 400 GiB.
# DATABASE_STORAGE_IOPS=
# DATABASE_STORAGE_THROUGHPUT_MIBPS=

# Days of automated backups (0-35). Replicas require a positive value.
DATABASE_BACKUP_RETENTION_DAYS=7
# Optional UTC windows, at least 30 minutes, with no overlap.
# DATABASE_BACKUP_WINDOW=02:00-02:30
# DATABASE_MAINTENANCE_WINDOW=sun:03:00-sun:03:30
DATABASE_AUTO_MINOR_VERSION_UPGRADE=true
# Optional: false defers supported changes to maintenance; omitted preserves CDK behavior.
# DATABASE_APPLY_IMMEDIATELY=false

# Each replica is an additional billed instance. Multi-AZ standby is not a read replica.
# Adding replicas does not route queries automatically: declare database: { readers: true }
# and call databaseConnection({ role: "reader" }) for reads that tolerate replication lag.
DATABASE_READ_REPLICA_COUNT=0
# Blank inherits the writer's instance class. Replicas inherit its storage settings.
# DATABASE_READ_REPLICA_INSTANCE_CLASS=
DATABASE_READ_REPLICA_MULTI_AZ=false

# Optional additional billed service for application writer connection pooling/failover.
# End-to-end IAM + TLS; migrations connect directly, replica reads bypass Proxy.
DATABASE_PROXY_ENABLED=false
DATABASE_PROXY_MAX_CONNECTIONS_PERCENT=90
DATABASE_PROXY_BORROW_TIMEOUT_SECONDS=15
DATABASE_PROXY_IDLE_CLIENT_TIMEOUT_SECONDS=1800

# Optional CloudWatch exports (postgresql,upgrade); logs incur storage/ingestion charges.
# DATABASE_CLOUDWATCH_LOGS_EXPORTS=postgresql,upgrade
DATABASE_LOG_RETENTION_DAYS=30

# Deletion protection and retain policy on the database, replicas and user pool.
# Without it, deleting the writer still leaves a final snapshot; replicas are disposable.
# RETAIN_STATEFUL_RESOURCES=true


# ==============================================================================
#  FEATURE FLAGS & SERVICES
# ==============================================================================
# Deploys AWS WebSocket API Gateway and handler Lambdas routed via framework-config
DEPLOY_PROD_WEBSOCKET_API=false


# ==============================================================================
#  LANGGRAPH MODEL SELECTION
# ==============================================================================
# Allowed values (case-insensitive): bedrock-mantle, bedrock, openai
# Leave blank to use the default in framework-config/resources.ts (bedrock-mantle)
LANGGRAPH_MODEL_PROVIDER=

# ==============================================================================
#  PROVIDER MODEL CONFIGURATION
# ==============================================================================
# Optional: Leave blank to use the model defaults in framework-config/resources.ts
LANGGRAPH_BEDROCK_MANTLE_MODEL_ID=
LANGGRAPH_BEDROCK_MODEL_ID=
LANGGRAPH_OPENAI_MODEL_ID=

# ==============================================================================
#  API AUTHENTICATION
# ==============================================================================
# Required when LANGGRAPH_MODEL_PROVIDER="openai"
OPENAI_API_KEY=
