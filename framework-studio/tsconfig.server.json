{
  // The studio's Node half: the server, the evaluator child and their tests.
  // Run through tsx, so extensionless imports and bundler resolution, as the
  // framework's own scripts are checked (packages/framework/tsconfig.tools.json).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["server/**/*.ts", "shared/**/*.ts", "test/**/*.ts"]
}
