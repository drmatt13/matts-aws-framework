{
  // The Node test runner also imports browser components for DOM interaction tests.
  // Run through tsx, so extensionless imports and bundler resolution, as the
  // framework's own scripts are checked (packages/framework/tsconfig.tools.json).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["server/**/*.ts", "shared/**/*.ts", "test/**/*.ts", "test/browser/**/*.tsx", "test/browser/**/*.mts", "playwright.config.ts"]
}
