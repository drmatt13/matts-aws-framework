{
  "name": "framework-studio",
  "author": "Matthew Sweeney",
  "license": "UNLICENSED",
  "private": true,
  "description": "A local, source-linked view of framework.config.ts: what the config declares, where each declaration was written, and a narrow set of validated edits written back to it.",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "node --conditions=development --import tsx --test --test-concurrency=4 test/*.test.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@prisma/orm-framework": "8.0.0-rc.14",
    "@prisma/orm-postgres": "8.0.0-rc.14",
    "@prisma/orm-toolchain": "8.0.0-rc.14",
    "@repo/framework": "*",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-router": "^1.170.41",
    "express": "^5.2.1",
    "lucide-react": "^0.545.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "28.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.4"
  }
}
