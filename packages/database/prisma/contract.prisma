// use prisma-8

// The application data contract. This is the source of truth for the schema:
// `prisma contract emit` generates the client artifacts from it, and
// `prisma migration plan` turns changes to it into on-disk migrations.
model User {
  id             Uuid    @id(map: "users_pkey") @default(uuid())
  cognitoSub     String  @map("cognito_sub")
  email          String
  firstName      String  @map("first_name")
  lastName       String  @map("last_name")
  createdAt      TimestamptzString(6) @default(now()) @map("created_at")
  updatedAt      temporal.timestamptzString(6, onCreate: now, onUpdate: now) @map("updated_at")

  @@index([cognitoSub], map: "users_cognito_sub_key", unique: true)
  @@index([email], map: "users_email_key", unique: true)
  @@map("users")
}

model Project {
  id        Uuid    @id(map: "projects_pkey") @default(uuid())
  ownerId   Uuid    @map("owner_id")
  owner     User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  archived  Boolean @default(false)
  createdAt TimestamptzString(6) @default(now()) @map("created_at")
  updatedAt temporal.timestamptzString(6, onCreate: now, onUpdate: now) @map("updated_at")

  @@index([ownerId], map: "projects_owner_id_idx")
  @@map("projects")
}
