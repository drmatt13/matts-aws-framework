# Copy to .env and fill in from `npm run export:cdk-outputs`, or from the
# CloudFormation outputs of your deployed stacks.

# Target for the local dev server's /api proxy. Application code never reads
# this: it always calls a same-origin /api. Defaults to http://localhost:8080
# for local development as configured in docker-compose.
VITE_API_GATEWAY_URL=http://localhost:8080
# Source: WebSocketApiStack output. Only needed when WebSockets are enabled.
# Defaults to http://localhost:8081 for local development as configured in
# docker-compose.
VITE_API_GATEWAY_WS_URL=http://localhost:8081

# Source: CognitoStack outputs.
VITE_AWS_REGION=us-east-1
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=
VITE_COGNITO_DOMAIN=