# Copy to client-app/.env, then replace its values with the "Client app" block at
# the end of root .env. Every export writes that block, already deduplicated:
# a dev `npm run deploy:resources` exports automatically; after a production
# deployment run `npm run export:cdk-outputs -- --profile=<profile>` before building.

# ==============================================================================
#  API & WEBSOCKET ENDPOINTS
# ==============================================================================
# Vite proxy target for /api and agent routes; app requests stay same-origin.
# Dev: the local API server's host port. Production: the CloudFront URL.
# Vite reads root .env after this file, so the exported value takes precedence.
VITE_API_GATEWAY_URL=http://localhost:8080

# local-ws-dev-server on LOCAL_WS_DEV_SERVER_HOST_PORT. Dev only: Compose runs it
# whatever DEPLOY_PROD_WEBSOCKET_API says; empty in production. Prefills the tester's left panel.
VITE_LOCAL_WS_URL=ws://localhost:8081

# The deployed API Gateway WebSocket stage (wss://...), when the deployment built
# a WebSocketApiStack (DEPLOY_PROD_WEBSOCKET_API=true); otherwise empty. Prefills the
# tester's right panel.
VITE_API_GATEWAY_WS_URL=

# WebSocket tester link on the authenticated home page. Dev only, on
# WS_TESTER_HOST_PORT; empty in production, where no tester runs.
VITE_WS_TESTER_URL=http://localhost:3001


# ==============================================================================
#  AWS COGNITO AUTHENTICATION
# ==============================================================================
# The deployment's region and CognitoStack outputs.
VITE_AWS_REGION=us-east-1
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=
VITE_COGNITO_DOMAIN=
