# Copy to client-app/.env after `npm run deploy -- --all --profile=<profile>`.
# Deploy exports public Cognito values to the repository-root .env; copy them below.
# `npm run dev -- --profile=<profile>` starts the local services.

# ==============================================================================
#  API & WEBSOCKET ENDPOINTS
# ==============================================================================
# Vite proxy target for local /api and agent routes; app requests stay same-origin.
# Deploy derives this from the API host port in cdk-app/.env and writes it to root .env.
# Vite reads root .env after this file, so the generated value takes precedence.
VITE_API_GATEWAY_URL=http://localhost:8080

# Local WebSocket endpoint; use the WS host port configured in cdk-app/.env.
# A deployed WebSocket API has a separate output from WebSocketApiStack.
VITE_API_GATEWAY_WS_URL=http://localhost:8081

# WebSocket tester link on the authenticated home page. Match WS_TESTER_HOST_PORT
# in cdk-app/.env if you changed its default of 3001.
VITE_WS_TESTER_URL=http://localhost:3001


# ==============================================================================
#  AWS COGNITO AUTHENTICATION
# ==============================================================================
# Copy USER_POOL_ID, USER_POOL_CLIENT_ID, and COGNITO_DOMAIN_URL from root .env.
# Set VITE_AWS_REGION to the exported LOCAL_AWS_REGION.
VITE_AWS_REGION=us-east-1
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=
VITE_COGNITO_DOMAIN=
