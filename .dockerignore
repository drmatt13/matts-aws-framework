# Dependencies and build artifacts. Reinstalled or rebuilt inside the image.
**/node_modules
**/dist

# CDK output. Excluding these matters: the LangGraph image asset uses the
# repository root as its build context, so without them CDK stages cdk-app/cdk.out
# into itself and the asset balloons from a few dozen files to tens of thousands.
**/cdk.out
**/.cdk.staging

# VCS, editor, and agent state.
**/.git
.git
.gitignore
.vscode
.claude
.superpowers

# Never bake a developer's local secrets into an image. The build context is the
# repository root, so this covers every service's .env.
**/.env

*.log

# Exclude artifacts left by the retired local lifecycle tooling.
.framework

# All local env variants and validation artifacts are private.
**/.env*
**/.cache
packages/database/src/generated

# The architecture diagrams are 1.8 MB of the 2.1 MB context, and the repository
# root is also the build context for every task image the runner builds.
*.svg
